<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>Compilador</artifactId>
    <version>1.0-SNAPSHOT</version>

    <dependencies>
        <!-- Source: https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
        <!-- Source: https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-engine -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <app.mainClass>uncuyo.compiladores.Etapa2</app.mainClass>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${app.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>etapa1</id>
            <properties>
                <app.mainClass>uncuyo.compiladores.Etapa1</app.mainClass>
            </properties>
            <build>
                <finalName>etapa1</finalName>
            </build>
        </profile>
        <profile>
            <id>etapa2</id>
            <properties>
                <app.mainClass>uncuyo.compiladores.Etapa2</app.mainClass>
            </properties>
            <build>
                <finalName>etapa2</finalName>
            </build>
        </profile>
        <profile>
            <id>etapa3</id>
            <properties>
                <app.mainClass>uncuyo.compiladores.Etapa3</app.mainClass>
            </properties>
            <build>
                <finalName>etapa3</finalName>
            </build>
        </profile>
        <profile>
            <id>etapa4</id>
            <properties>
                <app.mainClass>uncuyo.compiladores.Etapa4</app.mainClass>
            </properties>
            <build>
                <finalName>etapa4</finalName>
            </build>
        </profile>
        <profile>
            <id>tinyS</id>
            <properties>
                <app.mainClass>uncuyo.compiladores.TinyS</app.mainClass>
            </properties>
            <build>
                <finalName>tinyS</finalName>
            </build>
        </profile>
    </profiles>

</project>
